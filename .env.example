# ==========================================
# ENTERPRISE DOCUMENT INTELLIGENCE & WHATSAPP ACTION AGENT
# PRAWIRA TOBACCO EDITION (.env.example)
# ==========================================

# 1. Database Configuration (PostgreSQL 16 + pgvector)
# Option A (Local Docker): postgresql://postgres:postgrespassword@localhost:5432/prawira_agent_db
# Option B (Supabase / Remote Postgres): postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/prawira_agent_db

# 2. Hybrid LLM & Embeddings Provider Selection
# Options: 'gemini' (Recommended) or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 3. WhatsApp Action Gateway Configuration
# Options: 'fonnte' (https://fonnte.com/) or direct wa.me fallback
WHATSAPP_GATEWAY=fonnte
FONNTE_TOKEN=your_fonnte_token_here
STORE_DEFAULT_PHONE=6283132001855

# 4. Service Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 5. Live Supabase Cloud Integration (Prawira Tobacco Production)
SUPABASE_URL=https://mitkblmftejogdxmewet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
